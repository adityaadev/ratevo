# Server Environment Variables
# Copy to .env and fill in values

# Server
PORT=4001
NODE_ENV=production

# Client URL (required for CORS) - comma-separated list
CLIENT_URL=

# Supabase (required)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini AI (required for AI review generation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Google OAuth (required for Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cashfree Payments (required for production payments)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST

# Email provider (required for transactional emails)
# Example: Resend, SendGrid, etc.
EMAIL_API_KEY=
EMAIL_FROM=

# Feature flags
BILLING_UI_ENABLED=false
ENFORCE_TRIAL_LOCK=false
PAYMENTS_PROVIDER=cashfree

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100