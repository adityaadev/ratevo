# Client Environment Variables
# Copy to .env.local and fill in values

# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API URL (required for production) - replace with your Render service URL
VITE_API_URL=https://YOUR-RENDER-SERVICE.onrender.com

# App URL (required for production)
VITE_APP_URL=https://ratevo.site

# Feature flags
VITE_BILLING_UI_ENABLED=false
VITE_ENFORCE_TRIAL_LOCK=false

# Analytics (optional)
VITE_GA_MEASUREMENT_ID=